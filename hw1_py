    def colorseparation(self):
        if self.image1 is not None:
            cv2.imshow('image1',self.image1)
            b, g, r = cv2.split(self.image1)  
            empty_channel = np.zeros_like(b)
            blue_image = cv2.merge([b, empty_channel, empty_channel])
            green_image = cv2.merge([empty_channel, g, empty_channel])
            red_image = cv2.merge([empty_channel, empty_channel, r])
            cv2.imshow("Blue Channel", blue_image)
            cv2.imshow("Green Channel", green_image)
            cv2.imshow("Red Channel", red_image)
            cv2.waitKey(0)
    def colortransformation(self):
        if self.image1 is not None:
            b, g, r = cv2.split(self.image1)  
            empty_channel = np.zeros_like(b)
            blue_image = cv2.merge([b, empty_channel, empty_channel])
            green_image = cv2.merge([empty_channel, g, empty_channel])
            red_image = cv2.merge([empty_channel, empty_channel, r])
            I1 = cv2.cvtColor(self.image1, cv2.COLOR_BGR2GRAY)
            I2=(blue_image+green_image+red_image)/3
            I2 = (I2* 255).astype(np.uint8)
            I2=cv2.cvtColor(I2,cv2.COLOR_BGR2GRAY)
            cv2.imshow("grayscale_image1",I1)
            cv2.imshow("Average weighted",I2)
    def colorextraction(self):
        if self.image1 is not None:
            hsv=cv2.cvtColor(self.image1, cv2.COLOR_BGR2HSV)
            lower_bound = np.array([17, 35, 25])
            upper_bound = np.array([85, 255, 255])
            mask=cv2.inRange(hsv, lower_bound, upper_bound)
            mask_bgr=cv2.cvtColor(mask, cv2.COLOR_GRAY2BGR)
            I2=cv2.bitwise_not(mask_bgr ,self.image1 ,mask)
            cv2.imshow("mask",mask)
            cv2.imshow("Image without yellow and green  ",I2)
    def gaussianblur(self):
        def on_change(value):
            if self.image1 is not None:
                m = value
                kernel_size = (2*m+1,2*m+1)
                blurred_image = cv2.GaussianBlur(self.image1, kernel_size, 0)
                cv2.imshow("Gaussian Blurred Image", blurred_image)
        if self.image1 is not None:
