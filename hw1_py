    def sobelx(self):
        if self.image1 is not None:
            gray_image1=cv2.cvtColor(self.image1, cv2.COLOR_BGR2GRAY)
            gray_image1 = cv2.GaussianBlur(gray_image1,(3,3), 0)
            sobel_x = np.array([[-1, 0, 1],
                                [-2, 0, 2],
                                [-1, 0, 1]])
            height, width = gray_image1.shape
            sobel_x_result = np.zeros((height, width), dtype=np.uint8)
            pixel_valuex = np.zeros((height, width), dtype=np.float32)

            for i in range(1, height - 1):
                for j in range(1, width - 1):
                    pixel_value_x = (
                    sobel_x[0, 0] * gray_image1[i - 1, j - 1] + sobel_x[0, 1] * gray_image1[i - 1, j] + sobel_x[0, 2] * gray_image1[i - 1, j + 1] +
                    sobel_x[1, 0] * gray_image1[i, j - 1] + sobel_x[1, 1] * gray_image1[i, j] + sobel_x[1, 2] * gray_image1[i, j + 1] +
                    sobel_x[2, 0] * gray_image1[i + 1, j - 1] + sobel_x[2, 1] * gray_image1[i + 1, j] + sobel_x[2, 2] * gray_image1[i + 1, j + 1]
                                  )
                    pixel_valuex[i, j]= pixel_value_x
                    sobel_x_result[i, j] = abs(pixel_value_x)

        sobel_x_result=cv2.normalize(sobel_x_result,None,0,255,cv2.NORM_MINMAX)
        self.sobel_x_result = sobel_x_result 
        self.pixel_valuex=pixel_valuex
        cv2.imshow('Sobel X',sobel_x_result)

    def sobely(self):
        if self.image1 is not None:
            gray_image1=cv2.cvtColor(self.image1, cv2.COLOR_BGR2GRAY)
            gray_image1 = cv2.GaussianBlur(gray_image1,(3,3), 0)
            sobel_y = np.array([[-1, -2, -1],
                                [0, 0, 0],
                                [1, 2, 1]])
            height, width = gray_image1.shape
            sobel_y_result = np.zeros((height, width), dtype=np.uint8)
            pixel_valuey= np.zeros((height, width), dtype=np.float32)
            for i in range(1, height - 1):
                for j in range(1, width - 1):
                    pixel_value_y = (
                    sobel_y[0, 0] * gray_image1[i - 1, j - 1] + sobel_y[0, 1] * gray_image1[i - 1, j] + sobel_y[0, 2] * gray_image1[i - 1, j + 1] +
                    sobel_y[1, 0] * gray_image1[i, j - 1] + sobel_y[1, 1] * gray_image1[i, j] + sobel_y[1, 2] * gray_image1[i, j + 1] +
                    sobel_y[2, 0] * gray_image1[i + 1, j - 1] + sobel_y[2, 1] * gray_image1[i + 1, j] + sobel_y[2, 2] * gray_image1[i + 1, j + 1]
                                  )
                    pixel_valuey [i,j]= pixel_value_y
                    sobel_y_result[i, j] = abs(pixel_value_y)
        sobel_y_result=cv2.normalize(sobel_y_result,None,0,255,cv2.NORM_MINMAX)
        self.sobel_y_result = sobel_y_result
        self.pixel_valuey=pixel_valuey
        cv2.imshow('Sobel y',sobel_y_result)

    def combination(self):
         if self.sobel_x_result is not None and self.sobel_y_result is not None:
            abs_grad_x = cv2.convertScaleAbs(self.sobel_x_result)
            abs_grad_y = cv2.convertScaleAbs(self.sobel_y_result)
            grad = cv2.addWeighted(abs_grad_x, 0.5, abs_grad_y, 0.5, 0)
            combined_result = grad.astype(np.uint8)
            cv2.imshow('Combination', combined_result)
            threshold = 128
            threshold_com=combined_result.copy()
            threshold_com[threshold_com < threshold] = 0
            threshold_com[threshold_com >= threshold] = 255
            cv2.imshow('threshold',threshold_com)
            self.combined_result=combined_result
    def gradient(self):
        gradient_angle = np.zeros((self.pixel_valuex.shape[0], self.pixel_valuex.shape[1]), dtype=np.float32) 
        for i in range(self.pixel_valuex.shape[0]):
            for j in range(self.pixel_valuex.shape[1]):
                if (self.pixel_valuey[i][j]<0):
                    gradient_angle[i][j] = np.arctan2(self.pixel_valuey[i][j],self.pixel_valuex[i][j])
                    gradient_angle[i][j] = np.degrees(gradient_angle[i][j]).astype(np.uint8)+180
                else:
                    gradient_angle[i][j] = np.arctan2(self.pixel_valuey[i][j],self.pixel_valuex[i][j])
                    gradient_angle[i][j] = np.degrees(gradient_angle[i][j]).astype(np.uint8)
        mask1 = np.zeros_like(gradient_angle)
        mask1[(gradient_angle >= 120) & (gradient_angle <= 180)] = 255
        mask1 = mask1.astype(np.uint8)
        mask2 = np.zeros_like(gradient_angle)
        mask2[(gradient_angle >= 210) & (gradient_angle <= 330)] = 255
        mask2 = mask2.astype(np.uint8)
        result1 = cv2.bitwise_and(self.combined_result, mask1)
        result2 = cv2.bitwise_and(self.combined_result, mask2)
        cv2.imshow('Result 1 (120-180 degrees)', result1)
        cv2.imshow('Result 2 (210-330 degrees)', result2)

    def transform(self):
        if self.image1 is not None:
            rotation=eval(self.ui.plainTextEdit1.toPlainText())
            scale=eval(self.ui.plainTextEdit2.toPlainText())
            tx=eval(self.ui.plainTextEdit3.toPlainText())
            ty=eval(self.ui.plainTextEdit4.toPlainText())
            translation_matrix = np.float32([[1, 0, 240+tx], [0, 1, 200+ty]])
            translated_image = cv2.warpAffine(self.image1, translation_matrix, (self.image1.shape[1], self.image1.shape[0]))
            center_x = 240 + tx
            center_y = 200 + ty
            M = cv2.getRotationMatrix2D((center_x, center_y), rotation, scale)
            image=cv2.warpAffine(translated_image,M,(int(self.image1.shape[1]), int(self.image1.shape[0])))
            cv2.imshow('transform',image)
            
